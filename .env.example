# Backend env template. Copy to .env (gitignored) and fill in real values.

# Express port (inside the container).
NODE_ENV_PORT_LOCALHOST=3000

# MongoDB connection string. Local dev: localhost. In Docker: use the service
# name `mongo` (see gaming-shop-deploy compose).
NODE_ENV_DB_LOCALHOST=mongodb://localhost:27017/Gaming-Shop

# MongoDB collection names.
GAMES_PATH=games
DEV_PATH=developers
GENRE_PATH=genres

# --- Cloudflare R2 (image storage; replaces Supabase) ---
# Account ID, bucket, and public custom domain are not secret.
R2_ACCOUNT_ID=
R2_BUCKET=axlothecook-images
R2_PUBLIC_BASE=https://images.axlothecook.com
# Secrets from the R2 "Object Read & Write" API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Supabase (legacy image storage — kept until R2 migration verified) ---
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
